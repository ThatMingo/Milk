+// Splash/oMLX can publish prefill progress less frequently than the UI polls.
+// Calculate an observed rate only when processed tokens *change*. Repeated
+// identical snapshots must not reset the measurement clock, and the latest
+// valid measurement stays visible until this request stops or is replaced.
+struct PrefillSpeedEstimator {
+    private var lastProgress: (request: String, tokens: Int, time: TimeInterval)?
+    private var lastKnownSpeed: Double?
+
+    mutating func update(_ reading: inout LiveReading, at time: TimeInterval) {
+        guard reading.phase == .processing else {
+            reset()
+            return
+        }
+        let request = reading.requestID ?? "unknown-request"
+        if let previous = lastProgress, previous.request != request || reading.tokens < previous.tokens {
+            reset()
+        }
+
+        if let speed = reading.speed, speed.isFinite, speed > 0 {
+            lastKnownSpeed = speed
+        }
+        if let previous = lastProgress, previous.request == request,
+           reading.tokens > previous.tokens {
+            let interval = time - previous.time
+            if interval.isFinite && interval >= 0.25 {
+                let observed = Double(reading.tokens - previous.tokens) / interval
+                if observed.isFinite && observed > 0 {
+                    lastKnownSpeed = observed
+                }
+            }
+        }
+        // Take a new baseline only when token progress changes. If we
+        // reset it on every 0.5-second poll, sparse updates look like false
+        // spikes or are discarded entirely.
+        if lastProgress?.tokens != reading.tokens || lastProgress?.request != request {
+            lastProgress = (request, reading.tokens, time)
+        }
+        if reading.speed == nil || reading.speed == 0 {
+            reading.speed = lastKnownSpeed
+        }
+    }
+
+    mutating func reset() {
+        lastProgress = nil
+        lastKnownSpeed = nil
+    }
+}
